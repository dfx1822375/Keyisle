import { LineEdit, ComboBox, ScrollView, TextEdit, CheckBox, Palette, AboutSlint } from "std-widgets.slint";

import { Theme, Surface, SectionCard, SensitiveBadge, StatusBanner, Button, SecretField, BrandMark, WindowControl } from "components.slint";

export enum FillAction { password, username, both }

export struct EntryRow {
    title: string,
    username: string,
    detail: string,
    title-rich: styled-text,
    user-rich: styled-text,
    detail-rich: styled-text,
    hint: string,
    hint-rich: styled-text,
    sensitive: bool,
}

export struct BackupRow { title: string, detail: string }

export component AppWindow inherits Window {
    in property <bool> compact;
    out property <string> match-color: Theme.match-color;
    public function apply-appearance() { Theme.dark = root.effective-dark; Palette.color-scheme = root.effective-dark ? ColorScheme.dark : ColorScheme.light; }
    init => { root.apply-appearance(); }
    in-out property <int> appearance-mode;
    in-out property <int> appearance-choice;
    in-out property <bool> system-dark;
    out property <bool> effective-dark: root.appearance-mode == 2 || (root.appearance-mode == 0 && root.system-dark);
    changed effective-dark => { root.apply-appearance(); root.appearance-changed(); }
    callback appearance-changed();
    callback restore-layout();
    callback process-jobs();
    title: compact ? "Keyisle · 快速填充" : "Keyisle · 账号管理";
    no-frame: true;
    icon: @image-url("../assets/keyisle.svg");
    out property <length> window-radius: Theme.window-radius;
    callback drag-window();
    callback system-menu();
    in-out property <int> theme-index;
    in-out property <int> theme-choice;
    changed theme-index => { Theme.scheme = root.theme-index; }
    in-out property <int> secret-serial;
    in-out property <bool> max-hovered;
    in-out property <string> success-status;
    in-out property <int> status-serial;
    out property <bool> status-success: root.status != "" && root.status == root.success-status;
    in-out property <bool> app-menu-open;
    private property <int> app-menu-index;
    callback manage-context(int);
    in-out property <length> desktop-width: 820px;
    in-out property <length> desktop-height: 620px;
    out property <length> desktop-min-width: 640px;
    out property <length> desktop-min-height: 560px;
    in-out property <bool> is-maximized;
    callback minimize-window();
    callback maximize-window();
    callback update-frame();
    always-on-top: compact;
    callback resize-for-page();
    out property <bool> fixed-page: compact || !root.unlocked || root.verification-active || root.reset-open || root.about-open;
    out property <length> page-width: root.reset-open ? 600px : root.about-open ? 540px : compact ? 600px : !root.unlocked ? 480px : root.verification-active ? 600px : root.desktop-width;
    preferred-width: root.page-width;
    changed page-width => { root.resize-for-page(); }
    // Keep a status slot so starting a fill never resizes or reactivates the popup.
    out property <length> popup-height: root.verification-active ? 480px : !root.unlocked ? (root.new-vault ? 330px : 290px) : 204px + min(5, max(1, root.entries.length)) * 64px;
    out property <length> page-height: root.reset-open ? 460px : root.about-open ? 500px : compact ? root.popup-height : !root.unlocked ? (root.new-vault ? 330px : 290px) : root.verification-active ? 480px : root.desktop-height;
    preferred-height: root.page-height;
    changed page-height => { root.resize-for-page(); }
    min-width: root.reset-open ? 600px : root.about-open ? 540px : compact ? 600px : !root.unlocked ? 480px : root.verification-active ? 600px : root.desktop-min-width;
    min-height: root.reset-open ? 460px : root.about-open ? 500px : compact ? root.popup-height : !root.unlocked ? (root.new-vault ? 330px : 290px) : root.verification-active ? 480px : root.desktop-min-height;
    max-width: root.reset-open ? 600px : root.about-open ? 540px : compact ? 600px : !root.unlocked ? 480px : root.verification-active ? 600px : 32767px;
    max-height: root.reset-open ? 460px : root.about-open ? 500px : compact ? root.popup-height : !root.unlocked ? (root.new-vault ? 330px : 290px) : root.verification-active ? 480px : 32767px;
    background: Theme.canvas;
    in-out property <bool> repaint-frame;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    in property <[EntryRow]> entries;
    in-out property <int> selected: 0;
    in-out property <string> query;
    in-out property <string> category;
    in-out property <string> tag;
    in-out property <int> category-index;
    in-out property <int> tag-index;
    in-out property <string> shortcut-input;
    in property <string> shortcut-label;
    in-out property <bool> recording-shortcut;
    in-out property <string> shortcut-before-record;
    callback start-recording();
    callback cancel-recording();
    callback captured-shortcut(int,int);
    in-out property <string> status;
    in property <string> target-label;
    in property <string> target-detail;
    in property <bool> can-fill;
    in property <bool> busy;
    in property <bool> unlocked;
    changed unlocked => {
        if (!root.unlocked) {
            root.maximized = false;
            root.is-maximized = false;
            root.context-open = false;
            root.app-menu-open = false;
        }
    }
    in property <bool> new-vault;
    in property <bool> working;
    in property <bool> blocked;
    out property <bool> ui-blocked: root.blocked || root.reset-open;
    in property <string> policy-label;
    in-out property <bool> edit-sensitive;
    in-out property <bool> verification-active;
    changed verification-active => {
        if (root.verification-active) {
            root.maximized = false;
            root.is-maximized = false;
        }
    }
    in-out property <string> verification-label;
    in-out property <string> verify-master;
    in-out property <bool> reset-open;
    in-out property <bool> reset-confirmed;
    in-out property <bool> reset-incomplete;
    in-out property <string> reset-master;
    in-out property <string> reset-summary;
    callback open-reset();
    callback reset-profile();
    callback close-reset();
    in-out property <bool> settings-open;
    in-out property <bool> start-at-logon;
    in-out property <bool> start-in-tray;
    in-out property <bool> screen-protection-choice;
    in-out property <bool> auto-update-choice: true;
    in-out property <bool> context-open;
    changed blocked => { if (root.blocked) { root.context-open = false; root.app-menu-open = false; } }
    in-out property <bool> context-has-record;
    in-out property <float> context-x;
    in-out property <float> context-y;
    in-out property <int> context-index;
    callback request-context(float,float) -> bool;
    callback context-action(int);
    public function focus-context() { context-navigation.focus(); }
    out property <float> list-left: results.absolute-position.x / 1px;
    out property <float> list-top: results.absolute-position.y / 1px;
    out property <float> list-width: results.visible-width / 1px;
    out property <float> list-height: results.visible-height / 1px;
    out property <float> list-scroll: results.content-y / 1px;
    changed settings-open => { if (!root.settings-open) { root.cancel-recording(); } }
    changed context-open => { if (root.context-open) { context-navigation.focus(); } }
    public function scroll-selected() {
        if (root.selected < 0 || root.entries.length == 0) {
            results.content-y = 0px;
            return;
        }
        if (root.selected * 64px < -results.content-y) {
            results.content-y = -min(root.selected * 64px, max(0px, results.content-height - results.visible-height));
        } else if (root.selected * 64px + 64px > -results.content-y + results.visible-height) {
            results.content-y = -min(max(0px, root.selected * 64px + 64px - results.visible-height), max(0px, results.content-height - results.visible-height));
        }
    }
    public function scroll-backup-selected() {
        if (root.selected-backup < 0 || root.backup-rows.length == 0) {
            backups-view.content-y = 0px;
            return;
        }
        if (root.selected-backup * 72px < -backups-view.content-y) {
            backups-view.content-y = -min(root.selected-backup * 72px, max(0px, backups-view.content-height - backups-view.visible-height));
        } else if (root.selected-backup * 72px + 72px > -backups-view.content-y + backups-view.visible-height) {
            backups-view.content-y = -min(max(0px, root.selected-backup * 72px + 72px - backups-view.visible-height), max(0px, backups-view.content-height - backups-view.visible-height));
        }
    }
    in-out property <bool> backups-open;
    in property <[BackupRow]> backup-rows;
    in-out property <int> selected-backup: -1;
    in-out property <int> backup-confirm-mode;
    in-out property <string> backup-master;
    callback open-backups();
    callback close-backups();
    callback refresh-backups();
    callback delete-backup();
    callback restore-backup();
    changed selected-backup => {
        root.backup-confirm-mode = 0;
        root.backup-master = "";
        root.secret-serial += 1;
        root.activity();
    }
    in-out property <bool> maintenance-open;
    in-out property <bool> backups-confirm;
    in property <int> backup-count;
    in property <int> inactive-vault-count;
    in-out property <string> current-master;
    in-out property <string> new-master;
    in-out property <string> new-confirmation;
    callback open-maintenance();
    callback close-maintenance();
    callback change-master();
    callback clear-backups();
    in-out property <int> timeout-index: 1;
    in-out property <int> idle-source-index;
    callback activity();
    callback verify-password();
    public function verify-selected() { if (root.verify-source == 0) { root.verify-windows(); } else if (root.verify-source == 1) { root.verify-hello(); } else { root.verify-password(); } }
    callback verify-hello();
    callback verify-windows();
    in-out property <int> verify-source;
    callback cancel-verification();
    callback open-settings();
    callback save-settings();
    in property <string> vault-path;
    in property <[string]> categories;
    in property <[string]> tags;
    in-out property <bool> editing;
    in-out property <bool> edit-dirty;
    in-out property <bool> edit-is-new;
    in-out property <int> discard-action;
    out property <bool> discard-open: root.discard-action != 0;
    changed discard-open => { root.update-frame(); }
    callback finish-discard(bool);
    public function focus-discard() { root.discard-danger-focused = false; keep-editing.focus(); }
    private property <bool> discard-danger-focused;

    in-out property <bool> delete-confirm;
    in-out property <string> master;
    in-out property <string> confirmation;
    in-out property <string> edit-title;
    in-out property <string> edit-user;
    in-out property <string> edit-password;
    in-out property <string> edit-category;
    in-out property <string> edit-tags;
    in-out property <string> edit-url;
    in-out property <string> edit-notes;
    callback generate-password();
    in-out property <bool> about-open;
    in-out property <bool> about-from-settings;
    in-out property <string> app-version;
    in-out property <string> install-mode-label: "安装版";
    in-out property <bool> update-available;
    in-out property <string> update-version;
    in-out property <string> update-notes;
    in-out property <bool> update-checking;
    in-out property <bool> update-downloading;
    in-out property <bool> update-canceling;
    in-out property <bool> update-installing;
    in-out property <float> update-progress;
    in-out property <string> update-progress-text;
    in-out property <string> update-status;
    in-out property <string> update-error;
    callback open-about();
    callback close-about();
    callback open-slint-site();
    callback check-update();
    callback install-update();
    callback cancel-update();
    callback open-release-page();
    in-out property <bool> details-open;
    in-out property <string> details-title;
    in-out property <string> details-user;
    in-out property <string> details-password;
    in-out property <string> details-category;
    in-out property <string> details-tags;
    in-out property <string> details-url;
    in-out property <string> details-notes;
    callback view-entry();
    callback close-details();
    callback open-entry-url();
    callback copy-details-user();
    callback copy-details-password();
    callback unlock();
    callback lock-vault();
    callback session-changed();
    callback new-entry();
    callback edit-entry();
    callback save-entry();
    callback delete-entry();
    callback cancel-edit();
    callback backup();
    callback restore();
    callback native-open();
    callback open-management();
    callback search-changed();
    private property <FillAction> next-action: FillAction.password;
    callback fill(FillAction);
    callback cancel();
    callback exit-app();
    public function focus-search() { if (root.reset-open) { if (root.working) { reset-navigation.focus(); } else if (root.reset-incomplete) { reset-continue.focus(); } else { reset-password.focus(); } } else if (root.verification-active) { if (root.verify-source == 2) { verification-input.focus(); } else { verification-navigation.focus(); } } else if (root.backups-open) { if (root.backup-confirm-mode != 0) { backup-password-input.focus(); } else { backup-navigation.focus(); } } else if (root.maintenance-open) { current-master-input.focus(); } else if (root.editing) { edit-name-input.focus(); } else if (root.settings-open) { appearance-input.focus(); } else if (root.about-open) { about-back.focus(); } else if (root.details-open) { details-back.focus(); } else if (root.unlocked) { search.focus(); } else { master-input.focus(); } }
    forward-focus: keyboard;
    changed selected => {
        root.activity();
    }

    // A full-window dirty rectangle repairs lost software backing pixels after restore.
    Rectangle { width: parent.width; height: parent.height; background: root.repaint-frame ? Theme.canvas : Theme.repaint-canvas; }
    TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        enabled: !root.compact && !root.discard-open;
        pointer-event(event) => {
            if (root.fixed-page && event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.drag-window();
            }
        }
        moved => { if (self.pressed && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px)) { root.drag-window(); } }
        double-clicked => { if (!root.fixed-page) { root.maximize-window(); } }
    }
    keyboard := FocusScope {
        focus-on-click: false;
        enabled: !root.discard-open;
        key-pressed(event) => {
            root.activity();
            if (root.backups-open && !root.ui-blocked && root.backup-confirm-mode == 0 && root.backup-rows.length > 0) {
                if (event.text == Key.DownArrow) { root.selected-backup = min(root.selected-backup + 1, root.backup-rows.length - 1); root.scroll-backup-selected(); return accept; }
                if (event.text == Key.UpArrow) { root.selected-backup = max(root.selected-backup - 1, 0); root.scroll-backup-selected(); return accept; }
            }
            if (event.modifiers.alt && event.text == " " && !root.compact) { root.system-menu(); return accept; }
            if (event.text == Key.Escape) { if (root.reset-open) { if (!root.working && !root.reset-incomplete) { root.close-reset(); } } else if (root.verification-active) { root.cancel-verification(); } else if (root.backups-open) { if (root.backup-confirm-mode != 0 && !root.working) { root.backup-confirm-mode = 0; root.backup-master = ""; root.secret-serial += 1; } else { root.close-backups(); } } else if (root.maintenance-open) { root.close-maintenance(); } else if (root.settings-open) { root.settings-open = false; } else if (root.editing) { root.cancel-edit(); } else if (root.about-open) { root.close-about(); } else if (root.details-open) { root.close-details(); } else { root.cancel(); } return accept; }
            return reject;
        }

        // ==================== 1. MAIN ACCOUNT LIST & QUICK-FILL POPUP ====================
        Surface {
            x: 0px; y: 0px; border-radius: 0px; border-width: 0px; background: Theme.canvas;
            width: parent.width; height: parent.height;
            visible: root.unlocked && !root.details-open && !root.editing && !root.verification-active && !root.settings-open && !root.maintenance-open && !root.backups-open;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                if root.compact: HorizontalLayout {
                    spacing: 8px;
                    padding-right: 36px;
                    BrandMark { width: 22px; height: 22px; border-radius: 6px; y: (parent.height - self.height) / 2; }
                    Text { text: "快速填充"; font-size: 15px; font-weight: 700; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.entries.length + " 个结果 · Esc 收起"; font-size: 12px; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
                }
                if root.compact: SectionCard {
                    background: Theme.surface-muted;
                    border-radius: 7px;
                    height: root.target-detail != "" ? 42px : 26px;
                    VerticalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 1px;
                        Text { text: root.target-label; accessible-label: root.target-label; color: root.can-fill ? Theme.ink : Theme.warning; font-weight: 600; overflow: elide; font-size: 12px; }
                        if root.target-detail != "": Text { text: root.target-detail; color: Theme.muted; overflow: elide; font-size: 11px; }
                    }
                }
                if !root.compact: HorizontalLayout {
                    spacing: 10px; padding-right: 116px;
                    BrandMark { width: 30px; height: 30px; border-radius: 9px; y: (parent.height - self.height) / 2; }
                    Text { text: "Keyisle"; font-size: 20px; font-weight: 700; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 0; }
                    Text { text: root.policy-label; color: Theme.muted; font-size: 11.5px; min-width: 0px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    if root.update-available: Button {
                        icon: @image-url("../assets/icons/sparkles.svg");
                        text: "新版本 v" + root.update-version;
                        height: 30px;
                        label-padding: 10px;
                        enabled: !root.delete-confirm && !root.ui-blocked;
                        clicked => { root.open-about(); }
                    }
                    Button {
                        icon: @image-url("../assets/icons/plus.svg");
                        text: "新增账号";
                        width: 108px;
                        primary: true;
                        enabled: !root.delete-confirm && !root.ui-blocked;
                        clicked => { root.new-entry(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    search := LineEdit {
                        height: 36px;
                        accessible-label: "搜索账号";
                        text <=> root.query;
                        placeholder-text: "搜索名称、账号、标签、网址… 支持拼音／简拼／模糊匹配";
                        enabled: !root.busy && !root.ui-blocked;
                        key-pressed(event) => {
                            if (event.text == Key.F2 && !root.compact && !root.ui-blocked && !root.delete-confirm) { root.edit-entry(); return accept; }
                            if ((event.text == Key.F10 && event.modifiers.shift) || event.text == Key.Menu) {
                                if (root.selected >= 0 && !root.ui-blocked) { root.scroll-selected(); root.request-context(root.list-left + 12, root.list-top + root.selected * 64 + root.list-scroll + 20); }
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.selected = min(root.selected + 1, root.entries.length - 1); root.scroll-selected();
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                root.selected = max(root.selected - 1, 0); root.scroll-selected();
                                return accept;
                            }
                            if (event.text == Key.Return) {
                                if (event.modifiers.alt && !root.compact) { root.view-entry(); return accept; }
                                if (event.modifiers.alt || event.modifiers.meta) { return accept; }
                                root.next-action = event.modifiers.control ? FillAction.username : event.modifiers.shift ? FillAction.both : FillAction.password;
                            }
                            return reject;
                        }
                        edited => { root.search-changed(); }
                        accepted => { if (root.can-fill && !root.busy && !root.ui-blocked) { root.fill(root.next-action); } }
                    }
                }
                if !root.compact: HorizontalLayout {
                    spacing: 10px;
                    ComboBox {
                        height: Theme.control-height;
                        model: root.categories;
                        current-index <=> root.category-index;
                        accessible-label: "分类筛选";
                        enabled: !root.busy && !root.ui-blocked;
                        selected(value) => { root.category = self.current-index == 0 ? "" : value; root.search-changed(); }
                    }
                    ComboBox {
                        height: Theme.control-height;
                        model: root.tags;
                        current-index <=> root.tag-index;
                        accessible-label: "标签筛选";
                        enabled: !root.busy && !root.ui-blocked;
                        selected(value) => { root.tag = self.current-index == 0 ? "" : value; root.search-changed(); }
                    }
                }
                if !root.compact: HorizontalLayout {
                    min-height: 26px;
                    spacing: 8px;
                    Text { text: root.entries.length + " 个账号"; font-size: 12.5px; font-weight: 600; color: Theme.muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.query != "" || root.category != "" || root.tag != "": Button {
                        subtle: true;
                        text: "清除筛选";
                        height: 28px;
                        label-padding: 10px;
                        enabled: !root.busy && !root.ui-blocked;
                        clicked => { root.query = ""; root.category = ""; root.tag = ""; root.search-changed(); root.focus-search(); }
                    }
                }
                results := ScrollView {
                    vertical-stretch: 1;
                    min-height: 0px;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, root.entries.length * 64px);
                    TouchArea {
                        width: results.visible-width; height: results.content-height;
                        enabled: !root.busy && !root.ui-blocked;
                        moved => { if (!root.compact && self.pressed && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px)) { root.drag-window(); } }
                        pointer-event(event) => { if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) { root.request-context((self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px); } }
                        VerticalLayout {
                            y: 0px;
                            width: parent.width;
                            height: root.entries.length > 0 ? root.entries.length * 64px - (root.compact ? 8px : 4px) : 56px;
                            spacing: root.compact ? 8px : 4px;
                            for entry[index] in root.entries: Rectangle {
                                height: root.compact ? 56px : 60px;
                                border-radius: 10px;
                                background: index == root.selected ? Theme.selection : row-touch.has-hover ? Theme.hover : Theme.surface;
                                border-width: 1px;
                                border-color: index == root.selected ? Theme.selection-line : row-touch.has-hover ? Theme.line : Theme.line-subtle;
                                accessible-role: button;
                                accessible-label: (index == root.selected ? "已选择，" : "") + entry.title + "，" + entry.username + "，" + entry.detail;
                                accessible-action-default => { root.selected = index; }
                                if index == root.selected: Rectangle { x: 0px; y: 10px; width: 3.5px; height: parent.height - 20px; border-radius: 2px; background: Theme.brand; }
                                VerticalLayout {
                                    padding: 6px;
                                    padding-left: 13px;
                                    padding-right: 12px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        if entry.sensitive: SensitiveBadge { y: (parent.height - self.height) / 2; }
                                        StyledText { accessible-role: text; accessible-label: entry.title; text: entry.title-rich; default-color: Theme.ink; default-font-size: 14px; min-width: 0px; max-lines: 1; }
                                    }
                                    StyledText { accessible-role: text; accessible-label: root.compact ? entry.hint : entry.username; text: root.compact ? entry.hint-rich : entry.user-rich; default-color: Theme.text; default-font-size: 12px; min-width: 0px; max-lines: 1; }
                                    if !root.compact: StyledText { accessible-role: text; accessible-label: entry.detail; text: entry.detail-rich; default-color: Theme.muted; default-font-size: 11px; min-width: 0px; max-lines: 1; }
                                }
                                row-touch := TouchArea {
                                    enabled: !root.busy && !root.ui-blocked;
                                    mouse-cursor: pointer;
                                    clicked => { root.selected = index; root.focus-search(); }
                                    double-clicked => { if (!root.compact && !root.ui-blocked && !root.delete-confirm) { root.selected = index; root.edit-entry(); } }
                                    moved => { if (!root.compact && self.pressed && (abs(self.mouse-x - self.pressed-x) > 5px || abs(self.mouse-y - self.pressed-y) > 5px)) { root.drag-window(); } }
                                    pointer-event(event) => { if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) { root.request-context((self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px); } }
                                }
                            }
                            if root.entries.length == 0: SectionCard {
                                height: 52px;
                                background: Theme.surface-muted;
                                Text {
                                    x: 14px; width: parent.width - 28px; height: parent.height;
                                    text: "没有匹配的账号，请调整关键词或筛选条件。";
                                    color: Theme.muted;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
                if root.status != "": StatusBanner { text: root.status; success: root.status-success; compact: root.compact; }
                if root.delete-confirm: HorizontalLayout {
                    spacing: 8px;
                    Button { icon: @image-url("../assets/icons/trash.svg"); danger: true; primary: true; text: "确认删除"; enabled: !root.ui-blocked; clicked => { root.delete-entry(); } }
                    Button { text: "取消删除"; clicked => { root.delete-confirm = false; root.status = ""; root.focus-search(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if !root.compact: Rectangle { height: 1px; background: Theme.line-subtle; }
                if !root.compact: HorizontalLayout {
                    spacing: 8px;
                    Button { icon: @image-url("../assets/icons/settings.svg"); subtle: true; text: "设置"; enabled: !root.ui-blocked; clicked => { root.open-settings(); } }
                    Button { icon: @image-url("../assets/icons/archive.svg"); subtle: true; text: "备份管理"; enabled: !root.ui-blocked; clicked => { root.open-backups(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "查看详情"; enabled: root.selected >= 0 && !root.ui-blocked && !root.delete-confirm; clicked => { root.view-entry(); } }
                    Button { icon: @image-url("../assets/icons/lock.svg"); text: "锁定"; clicked => { root.lock-vault(); } }
                    more-button := Button { icon: @image-url("../assets/icons/more.svg"); subtle: true; text: "更多"; enabled: !root.ui-blocked; clicked => { root.app-menu-index = 0; root.app-menu-open = !root.app-menu-open; if (root.app-menu-open) { app-menu.focus(); } } }
                }
                Text { text: root.compact ? "Enter 密码  ·  Ctrl+Enter 用户名  ·  Shift+Enter 连填  ·  Ctrl+Shift+M 管理" : root.shortcut-label + " 快速填充  ·  Alt+Enter 详情  ·  F2 / 双击编辑  ·  右键更多操作"; color: Theme.muted; font-size: root.compact ? 11px : 11.5px; }
            }
        }

        // ==================== 2. UNLOCK & CREATE VAULT ====================
        Surface {
            visible: !root.unlocked && !root.reset-open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-width: 0px; border-radius: 0px; background: Theme.canvas;
            VerticalLayout {
                padding: 18px; spacing: 7px;
                if !root.compact: HorizontalLayout {
                    spacing: 10px; alignment: start; padding-right: 80px;
                    BrandMark { width: 34px; height: 34px; border-radius: 10px; }
                    VerticalLayout {
                        spacing: 1px;
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: "Keyisle"; color: Theme.ink; font-size: 14px; font-weight: 700; }
                        Text {
                            text: root.update-available ? "发现新版本 v" + root.update-version + " · 可在“关于”中覆盖更新" : "本地加密密码库";
                            color: root.update-available ? Theme.brand : Theme.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
                Text { text: root.new-vault ? "创建本地密码库" : "解锁密码库"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                Text { text: root.new-vault ? "设置至少 10 个字符的主密码，忘记后无法找回。" : "输入主密码后即可搜索与快捷填充账号。"; font-size: 12.5px; wrap: word-wrap; color: Theme.muted; }
                master-input := SecretField {
                    text <=> root.master;
                    placeholder-text: "主密码";
                    mask-serial: root.secret-serial;
                    enabled: !root.working;
                    accepted => {
                        if (!root.working) {
                            if (root.new-vault) { confirm-input.focus(); } else { root.unlock(); }
                        }
                    }
                }
                confirm-input := SecretField {
                    visible: root.new-vault;
                    height: root.new-vault ? 36px : 0px;
                    text <=> root.confirmation;
                    placeholder-text: "再次输入主密码";
                    mask-serial: root.secret-serial;
                    enabled: !root.working && root.new-vault;
                    accepted => { if (!root.working && root.new-vault) { root.unlock(); } }
                }
                Button {
                    text: root.working ? "正在处理…" : root.new-vault ? "创建密码库" : "解锁";
                    primary: true;
                    horizontal-stretch: 1;
                    label-padding: 16px;
                    enabled: !root.working;
                    clicked => { root.unlock(); }
                }
                if root.status != "": StatusBanner { text: root.status; success: root.status-success; compact: true; }
                Rectangle { vertical-stretch: 1; min-height: 0px; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Button { text: "恢复备份"; label-padding: 12px; enabled: !root.working; clicked => { root.restore(); } }
                    Button { subtle: true; text: "收起"; label-padding: 12px; clicked => { root.cancel(); } }
                    if !root.compact: Button { subtle: true; text: "关于"; label-padding: 12px; enabled: !root.working; clicked => { root.open-about(); } }
                    if !root.compact: Button { subtle: true; text: "退出"; label-padding: 12px; clicked => { root.exit-app(); } }
                }
            }
        }

        // ==================== 3. ACCOUNT EDITOR ====================
        Surface {
            x: 0px; y: 0px; border-radius: 0px; border-width: 0px; background: Theme.canvas;
            width: parent.width; height: parent.height;
            visible: root.unlocked && root.editing && !root.verification-active && !root.settings-open && !root.maintenance-open && !root.backups-open;
            accessible-role: groupbox; accessible-label: "账号编辑表单";
            VerticalLayout {
                padding: 16px; spacing: 10px;
                VerticalLayout {
                    spacing: 2px;
                    padding-right: 116px;
                    Text { text: "账号信息"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                    Text { text: root.edit-is-new ? "新增记录，保存后自动定位到此账号" : "修改账号信息，保存前会自动生成加密备份"; color: Theme.muted; font-size: 12px; }
                }
                SectionCard {
                    height: 40px;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        CheckBox { enabled: !root.ui-blocked; text: "敏感项：使用、查看和编辑前再次验证"; checked <=> root.edit-sensitive; toggled => { root.edit-dirty = true; root.activity(); } }
                    }
                }
                ScrollView {
                    vertical-stretch: 1; content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 8px;
                        padding-right: 4px;
                        Text { text: "名称"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                        edit-name-input := LineEdit { height: Theme.control-height; enabled: !root.ui-blocked; text <=> root.edit-title; placeholder-text: "例如：企业邮箱 / GitHub"; edited => { root.edit-dirty = true; root.activity(); } }
                        Text { text: "用户名"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                        LineEdit { height: Theme.control-height; enabled: !root.ui-blocked; text <=> root.edit-user; placeholder-text: "登录账号、邮箱或手机号"; edited => { root.edit-dirty = true; root.activity(); } }
                        Text { text: "密码"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                        HorizontalLayout {
                            spacing: 6px;
                            SecretField {
                                horizontal-stretch: 1;
                                enabled: !root.ui-blocked;
                                text <=> root.edit-password;
                                mask-serial: root.secret-serial;
                                placeholder-text: "账号密码";
                                edited => { root.edit-dirty = true; root.activity(); }
                            }
                            Button {
                                icon: @image-url("../assets/icons/sparkles.svg");
                                text: "生成密码";
                                label-padding: 11px;
                                enabled: !root.ui-blocked;
                                clicked => { root.generate-password(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                Text { text: "分类"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                                LineEdit { height: Theme.control-height; enabled: !root.ui-blocked; text <=> root.edit-category; placeholder-text: "例如：工作 / 内网"; edited => { root.edit-dirty = true; root.activity(); } }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;
                                Text { text: "标签（逗号分隔）"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                                LineEdit { height: Theme.control-height; enabled: !root.ui-blocked; text <=> root.edit-tags; placeholder-text: "例如：客户端，VPN"; edited => { root.edit-dirty = true; root.activity(); } }
                            }
                        }
                        Text { text: "网址"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                        LineEdit { height: Theme.control-height; enabled: !root.ui-blocked; text <=> root.edit-url; placeholder-text: "https://…（支持搜索命中与详情页打开）"; edited => { root.edit-dirty = true; root.activity(); } }
                        Text { text: "备注"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                        TextEdit { enabled: !root.ui-blocked; text <=> root.edit-notes; height: 78px; edited => { root.edit-dirty = true; root.activity(); } }
                    }
                }
                if root.status != "": StatusBanner { text: root.status; success: root.status-success; }
                Rectangle { height: 1px; background: Theme.line-subtle; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "保存账号"; label-padding: 16px; enabled: !root.ui-blocked; primary: true; clicked => { root.save-entry(); } }
                    Button { subtle: true; text: "取消编辑"; clicked => { root.cancel-edit(); } }
                }
            }
        }

        // ==================== 4. SENSITIVE ITEM VERIFICATION ====================
        Surface {
            visible: root.unlocked && root.verification-active;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            border-width: 0px; border-radius: 0px; background: Theme.canvas;
            verification-navigation := FocusScope {
                focus-on-click: false;
                width: parent.width; height: parent.height;
                capture-key-pressed(event) => {
                    if (event.text == Key.Tab && !root.working) {
                        root.verify-master = "";
                        root.secret-serial += 1;
                        root.verify-source = Math.mod(root.verify-source + (event.modifiers.shift ? 2 : 1), 3);
                        root.focus-search(); return accept;
                    }
                    if (event.text == Key.Return && root.verify-source != 2 && !root.working) { root.verify-selected(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px; spacing: root.compact ? 9px : 11px;
                    HorizontalLayout {
                        spacing: 8px; padding-right: 76px; alignment: start;
                        SensitiveBadge { y: (parent.height - self.height) / 2; }
                        Text { text: "敏感项验证"; font-size: 20px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
                    }
                    SectionCard {
                        background: Theme.surface-muted;
                        height: 54px;
                        VerticalLayout {
                            padding: 9px; padding-left: 12px; spacing: 3px;
                            Text { text: root.verification-label; font-weight: 600; overflow: elide; color: Theme.ink; }
                            Text { text: "只授权当前账号的本次操作，不延长其他敏感项的权限。"; font-size: 11.5px; overflow: elide; color: Theme.muted; }
                        }
                    }
                    SectionCard {
                        background: Theme.surface-muted;
                        height: 44px;
                        border-radius: 10px;
                        HorizontalLayout {
                            padding: 4px;
                            spacing: 4px;
                            Button { text: "Windows 密码"; subtle: root.verify-source != 0; selected: root.verify-source == 0; horizontal-stretch: 1; enabled: !root.working; clicked => { root.verify-source = 0; root.verify-master = ""; root.secret-serial += 1; root.focus-search(); } }
                            Button { text: "PIN / Hello"; subtle: root.verify-source != 1; selected: root.verify-source == 1; horizontal-stretch: 1; enabled: !root.working; clicked => { root.verify-source = 1; root.verify-master = ""; root.secret-serial += 1; root.focus-search(); } }
                            Button { text: "密码库主密码"; subtle: root.verify-source != 2; selected: root.verify-source == 2; horizontal-stretch: 1; enabled: !root.working; clicked => { root.verify-source = 2; root.focus-search(); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "当前方式：" + (root.verify-source == 0 ? "Windows 账户密码" : root.verify-source == 1 ? "Windows PIN / Hello" : "密码库主密码"); font-weight: 600; color: Theme.ink; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "Tab 切换方式 · Enter 验证"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    }
                    verification-input := SecretField {
                        visible: root.verify-source == 2;
                        text <=> root.verify-master;
                        mask-serial: root.secret-serial;
                        placeholder-text: "密码库主密码";
                        enabled: !root.working;
                        edited => { root.activity(); }
                        accepted => { if (!root.working) { root.verify-selected(); } }
                    }
                    Button {
                        text: root.verify-source == 0 ? "打开 Windows 验证" : root.verify-source == 1 ? "Windows PIN / Hello" : "验证主密码";
                        primary: true;
                        horizontal-stretch: 1;
                        label-padding: 16px;
                        enabled: !root.working;
                        clicked => { root.verify-selected(); }
                    }
                    if root.status != "": StatusBanner { text: root.status; success: false; compact: root.compact; }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle { height: 1px; background: Theme.line-subtle; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Button { subtle: true; text: "取消验证"; clicked => { root.cancel-verification(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { icon: @image-url("../assets/icons/lock.svg"); text: "锁定密码库"; clicked => { root.lock-vault(); } }
                    }
                }
            }
        }

        // ==================== 5. SETTINGS ====================
        Surface {
            x: 0px; y: 0px; border-radius: 0px; border-width: 0px; background: Theme.canvas;
            width: parent.width; height: parent.height;
            visible: root.unlocked && root.settings-open && !root.verification-active && !root.maintenance-open && !root.backups-open;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                VerticalLayout {
                    spacing: 2px;
                    padding-right: 116px;
                    Text { text: "设置"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                    Text { text: "外观配色、快捷填充、自动锁定与隐私保护"; color: Theme.muted; font-size: 12px; }
                }
                ScrollView {
                    vertical-stretch: 1; content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 8px;
                        padding-right: 4px;
                        SectionCard {
                            VerticalLayout {
                                padding: 10px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 4px;
                                        Text { text: "外观模式"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                                        appearance-input := ComboBox { height: Theme.control-height; model: ["跟随系统 · 默认", "浅色", "深色"]; accessible-label: "外观模式"; current-index <=> root.appearance-choice; enabled: !root.ui-blocked; selected(value) => { root.activity(); } }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 4px;
                                        Text { text: "外观配色"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                                        ComboBox { height: Theme.control-height; model: ["青绿 · 默认", "经典蓝", "柔和紫", "石墨灰"]; accessible-label: "外观配色"; current-index <=> root.theme-choice; enabled: !root.ui-blocked; selected(value) => { root.activity(); } }
                                    }
                                }
                                CheckBox { text: "窗口防截屏保护（阻止截图与录屏软件捕获界面）"; checked <=> root.screen-protection-choice; enabled: !root.ui-blocked; toggled => { root.activity(); } }
                            }
                        }
                        SectionCard {
                            VerticalLayout {
                                padding: 10px; spacing: 6px;
                                Text { text: "快捷填充"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    LineEdit { horizontal-stretch: 1; height: Theme.control-height; text <=> root.shortcut-input; read-only: true; accessible-label: "呼出快捷键"; placeholder-text: "点击录制后按组合键"; enabled: !root.ui-blocked; }
                                    Button { text: root.recording-shortcut ? "取消录制" : "录制快捷键"; enabled: !root.ui-blocked; clicked => { if (root.recording-shortcut) { root.cancel-recording(); } else { root.start-recording(); } } }
                                }
                                Text { text: "直接按组合键录入，Esc 取消。已占用的组合可录入，保存时检测冲突。"; font-size: 12px; wrap: word-wrap; color: Theme.muted; }
                            }
                        }
                        SectionCard {
                            VerticalLayout {
                                padding: 10px; spacing: 6px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 4px;
                                        Text { text: "自动锁定时间"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                                        ComboBox { height: Theme.control-height; model: ["1 分钟", "5 分钟", "15 分钟", "30 分钟", "60 分钟"]; accessible-label: "自动锁定时间"; enabled: !root.ui-blocked; current-index <=> root.timeout-index; selected(value) => { root.activity(); } }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 4px;
                                        Text { text: "空闲计时依据"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                                        ComboBox { height: Theme.control-height; model: ["电脑无键鼠操作", "密码库无操作"]; accessible-label: "空闲计时依据"; enabled: !root.ui-blocked; current-index <=> root.idle-source-index; selected(value) => { root.activity(); } }
                                    }
                                }
                                Text { text: "Windows 锁屏、休眠和会话断开始终立即锁库。"; font-size: 12px; wrap: word-wrap; color: Theme.muted; }
                            }
                        }
                        SectionCard {
                            VerticalLayout {
                                padding: 10px; spacing: 5px;
                                Text { text: "启动与更新"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                                HorizontalLayout {
                                    spacing: 16px;
                                    CheckBox { horizontal-stretch: 1; text: "开机启动（当前 Windows 用户）"; checked <=> root.start-at-logon; enabled: !root.ui-blocked; toggled => { root.activity(); } }
                                    CheckBox { horizontal-stretch: 1; text: "开机启动时留在托盘"; checked <=> root.start-in-tray; enabled: !root.ui-blocked; toggled => { root.activity(); } }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    CheckBox {
                                        horizontal-stretch: 1;
                                        text: "启动后自动检查新版本（不上传本地数据）";
                                        checked <=> root.auto-update-choice;
                                        enabled: !root.ui-blocked;
                                        toggled => { root.activity(); }
                                    }
                                    if root.update-available: Button {
                                        icon: @image-url("../assets/icons/sparkles.svg");
                                        text: "前往更新 v" + root.update-version;
                                        height: 30px;
                                        label-padding: 10px;
                                        primary: true;
                                        enabled: !root.ui-blocked && !root.update-installing;
                                        clicked => { root.open-about(); }
                                    }
                                    Button {
                                        icon: @image-url("../assets/icons/refresh.svg");
                                        text: root.update-checking ? "检查中…" : "检查更新";
                                        height: 30px;
                                        label-padding: 10px;
                                        enabled: !root.ui-blocked && !root.update-checking && !root.update-downloading && !root.update-installing;
                                        clicked => { root.activity(); root.check-update(); }
                                    }
                                }
                                if root.update-available || root.update-status != "" || root.update-error != "": Text {
                                    text: root.update-available ? "已发现新版本 v" + root.update-version + "（发布者签名已验证），点击“前往更新”即可直接覆盖安装。" : root.update-error != "" ? root.update-error : root.update-status;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    color: root.update-available ? Theme.brand : root.update-error != "" ? Theme.danger : Theme.muted;
                                }
                            }
                        }
                        SectionCard {
                            VerticalLayout {
                                padding: 10px; spacing: 6px;
                                Text { text: "密码库维护与关于"; font-size: 13px; font-weight: 600; color: Theme.ink; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button { text: "主密码与本地备份"; enabled: !root.ui-blocked; clicked => { root.open-maintenance(); } }
                                    Button { icon: @image-url("../assets/icons/archive.svg"); text: "本地备份列表"; enabled: !root.ui-blocked; clicked => { root.open-backups(); } }
                                    Button { text: "关于 Keyisle"; enabled: !root.ui-blocked; clicked => { root.open-about(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { icon: @image-url("../assets/icons/trash.svg"); text: "一键还原"; danger: true; enabled: !root.ui-blocked; clicked => { root.open-reset(); } }
                                }
                            }
                        }
                    }
                }
                if root.status != "": StatusBanner { text: root.status; success: root.status-success; }
                Rectangle { height: 1px; background: Theme.line-subtle; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { text: "保存设置"; label-padding: 16px; primary: true; enabled: !root.ui-blocked && !root.recording-shortcut; clicked => { root.save-settings(); } }
                    Button { subtle: true; text: "返回账号列表"; enabled: !root.ui-blocked; clicked => { root.settings-open = false; root.activity(); } }
                }
            }
        }

        // ==================== 6. MASTER PASSWORD & LOCAL BACKUP MAINTENANCE ====================
        Surface {
            x: 0px; y: 0px; border-radius: 0px; border-width: 0px; background: Theme.canvas;
            width: parent.width; height: parent.height;
            visible: root.unlocked && root.maintenance-open && !root.verification-active && !root.backups-open;
            accessible-role: groupbox; accessible-label: "主密码与本地备份表单";
            VerticalLayout {
                padding: 16px; spacing: 10px;
                VerticalLayout {
                    spacing: 2px;
                    padding-right: 116px;
                    Text { text: "主密码与本地备份"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                    Text { text: "修改主密码并同步加密本地自动备份"; color: Theme.muted; font-size: 12px; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 10px;
                        padding-right: 4px;
                        SectionCard {
                            VerticalLayout {
                                padding: 12px; spacing: 8px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Text { text: "受管本地备份：" + root.backup-count + " 个"; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button { icon: @image-url("../assets/icons/archive.svg"); text: "查看本地备份列表"; enabled: !root.ui-blocked; clicked => { root.open-backups(); } }
                                }
                                Text { text: "包含自动备份和升级前备份。外部手动导出及恢复产生的独立旧库不在自动改密范围内。"; font-size: 12px; wrap: word-wrap; color: Theme.muted; }
                                if root.inactive-vault-count > 0: Text {
                                    text: "提示：数据目录中另有 " + root.inactive-vault-count + " 个未激活的独立历史库文件，它们保留各自的原主密码。";
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    color: Theme.warning;
                                }
                            }
                        }
                        SectionCard {
                            VerticalLayout {
                                padding: 12px; spacing: 8px;
                                Text { text: "当前主密码"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                                current-master-input := SecretField {
                                    text <=> root.current-master;
                                    label: "当前主密码";
                                    mask-serial: root.secret-serial;
                                    enabled: !root.ui-blocked;
                                    edited => { root.activity(); }
                                    accepted => {
                                        if (!root.ui-blocked) {
                                            if (root.backups-confirm) { root.clear-backups(); } else { new-master-input.focus(); }
                                        }
                                    }
                                }
                                Text { text: "新主密码（至少 10 个字符）"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                                new-master-input := SecretField {
                                    text <=> root.new-master;
                                    label: "新主密码";
                                    mask-serial: root.secret-serial;
                                    enabled: !root.ui-blocked && !root.backups-confirm;
                                    edited => { root.activity(); }
                                    accepted => { if (!root.ui-blocked && !root.backups-confirm) { new-confirm-input.focus(); } }
                                }
                                Text { text: "确认新主密码"; font-size: 12.5px; font-weight: 600; color: Theme.text; }
                                new-confirm-input := SecretField {
                                    text <=> root.new-confirmation;
                                    label: "确认新主密码";
                                    mask-serial: root.secret-serial;
                                    enabled: !root.ui-blocked && !root.backups-confirm;
                                    edited => { root.activity(); }
                                    accepted => { if (!root.ui-blocked && !root.backups-confirm) { root.change-master(); } }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button { text: "修改主密码并更新本地备份"; label-padding: 16px; primary: true; enabled: !root.ui-blocked && !root.backups-confirm; clicked => { root.change-master(); } }
                                }
                            }
                        }
                        SectionCard {
                            VerticalLayout {
                                padding: 12px; spacing: 8px;
                                Text { text: root.backups-confirm ? "确认永久删除这 " + root.backup-count + " 个本地备份？此操作无法撤销，当前密码库会保留。需验证上方的当前主密码。" : "清除后，后续编辑或删除账号仍会按规则生成自动备份。普通删除不等于底层存储安全擦除。"; font-size: 12px; wrap: word-wrap; color: root.backups-confirm ? Theme.warning : Theme.muted; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Button { icon: @image-url("../assets/icons/trash.svg"); danger: true; primary: root.backups-confirm; text: root.backups-confirm ? "确认清除全部本地备份" : "清除全部本地备份"; enabled: !root.ui-blocked && root.backup-count > 0; clicked => { root.clear-backups(); } }
                                    if root.backups-confirm: Button { text: "取消清除"; clicked => { root.backups-confirm = false; root.status = ""; root.activity(); } }
                                }
                            }
                        }
                    }
                }
                if root.status != "": StatusBanner { text: root.status; success: root.status-success; }
                Rectangle { height: 1px; background: Theme.line-subtle; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { subtle: true; text: "返回设置"; enabled: !root.ui-blocked; clicked => { root.close-maintenance(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { icon: @image-url("../assets/icons/lock.svg"); text: "锁定密码库"; clicked => { root.lock-vault(); } }
                }
            }
        }

        // ==================== 7. BACKUP MANAGER ====================
        Surface {
            x: 0px; y: 0px; border-radius: 0px; border-width: 0px; background: Theme.canvas;
            width: parent.width; height: parent.height;
            visible: root.unlocked && root.backups-open && !root.verification-active;
            accessible-role: groupbox; accessible-label: "本地备份列表表单";
            backup-navigation := FocusScope {
                focus-on-click: false;
                width: parent.width; height: parent.height;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    VerticalLayout {
                        spacing: 2px;
                        padding-right: 116px;
                        Text { text: "备份管理"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                        Text { text: "共 " + root.backup-rows.length + " 份 · 按原始备份时间倒序 · 恢复始终切换到独立副本"; font-size: 12px; color: Theme.muted; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { icon: @image-url("../assets/icons/archive.svg"); text: "加密备份"; enabled: !root.ui-blocked; clicked => { root.backup(); } }
                        Button { text: "恢复备份"; enabled: !root.ui-blocked; clicked => { root.restore(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { icon: @image-url("../assets/icons/refresh.svg"); subtle: true; text: "刷新备份列表"; enabled: !root.ui-blocked; clicked => { root.refresh-backups(); } }
                    }
                    backups-view := ScrollView {
                        vertical-stretch: 1; content-width: self.visible-width;
                        VerticalLayout {
                            spacing: 8px;
                            for row[index] in root.backup-rows: Rectangle {
                                height: 64px; border-radius: 10px; border-width: 1px;
                                background: index == root.selected-backup ? Theme.selection : backup-touch.has-hover ? Theme.hover : Theme.surface;
                                border-color: index == root.selected-backup ? Theme.selection-line : Theme.line-subtle;
                                accessible-role: button; accessible-label: (index == root.selected-backup ? "已选择，" : "") + row.title + "，" + row.detail;
                                accessible-action-default => { if (!root.ui-blocked) { root.selected-backup = index; } }
                                if index == root.selected-backup: Rectangle { x: 0px; y: 12px; width: 3.5px; height: parent.height - 24px; border-radius: 2px; background: Theme.brand; }
                                VerticalLayout {
                                    padding: 10px; padding-left: 14px; spacing: 4px;
                                    Text { text: row.title; color: Theme.ink; font-weight: 600; }
                                    Text { text: row.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                                backup-touch := TouchArea { enabled: !root.ui-blocked; mouse-cursor: pointer; clicked => { root.selected-backup = index; } }
                            }
                            if root.backup-rows.length == 0: SectionCard {
                                height: 56px;
                                background: Theme.surface-muted;
                                Text { x: 14px; width: parent.width - 28px; height: parent.height; vertical-alignment: center; text: "暂无本地备份。编辑或删除账号时会自动创建加密备份。"; color: Theme.muted; wrap: word-wrap; }
                            }
                        }
                    }
                    Text {
                        text: root.backup-confirm-mode == 1 ? "确认永久删除选中的这一份备份？请输入当前密码库的主密码。删除无法撤销。" : root.backup-confirm-mode == 2 ? "请输入选中备份的主密码，再确认恢复。验证成功后切换到独立恢复副本。" : "选中一份备份后，可执行校验恢复或单份删除。";
                        font-size: 12.5px;
                        wrap: word-wrap;
                        color: root.backup-confirm-mode == 0 ? Theme.muted : Theme.warning;
                    }
                    backup-password-input := SecretField {
                        visible: root.backup-confirm-mode != 0;
                        text <=> root.backup-master;
                        label: "备份操作验证密码";
                        mask-serial: root.secret-serial;
                        enabled: !root.ui-blocked;
                        edited => { root.activity(); }
                        accepted => {
                            if (!root.ui-blocked) {
                                if (root.backup-confirm-mode == 1) { root.delete-backup(); }
                                else if (root.backup-confirm-mode == 2) { root.restore-backup(); }
                            }
                        }
                    }
                    if root.status != "": StatusBanner { text: root.status; success: root.status-success; }
                    Rectangle { height: 1px; background: Theme.line-subtle; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { subtle: true; text: root.settings-open ? "返回设置" : "返回账号列表"; clicked => { root.close-backups(); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.backup-confirm-mode != 0: Button { text: "取消备份操作"; enabled: !root.ui-blocked; clicked => { root.backup-confirm-mode = 0; root.backup-master = ""; root.secret-serial += 1; root.status = ""; root.activity(); } }
                        Button { icon: @image-url("../assets/icons/trash.svg"); danger: true; primary: root.backup-confirm-mode == 1; text: root.backup-confirm-mode == 1 ? "确认删除此备份" : "删除选中备份"; enabled: !root.ui-blocked && root.selected-backup >= 0 && root.backup-confirm-mode != 2; clicked => { root.delete-backup(); } }
                        Button { primary: root.backup-confirm-mode == 2; text: root.backup-confirm-mode == 2 ? "确认恢复此备份" : "恢复选中备份"; enabled: !root.ui-blocked && root.selected-backup >= 0 && root.backup-confirm-mode != 1; clicked => { root.restore-backup(); } }
                    }
                }
            }
        }
    }

    // ==================== 8. FULL RESET MODAL ====================
    Rectangle {
        visible: root.reset-open;
        width: parent.width; height: parent.height; background: Theme.canvas;
        TouchArea {}
        reset-navigation := FocusScope {
            width: parent.width; height: parent.height;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) { if (!root.working && !root.reset-incomplete) { root.close-reset(); } return accept; }
                if (event.text == Key.Tab) {
                    if (root.working) { return accept; }
                    if (root.reset-incomplete) { reset-continue.focus(); return accept; }
                    if (event.modifiers.shift && reset-password.input-focused) { if (reset-continue.enabled) { reset-continue.focus(); } else { reset-cancel.focus(); } return accept; }
                    if (!event.modifiers.shift && (reset-continue.focused || (reset-cancel.focused && !reset-continue.enabled))) { reset-password.focus(); return accept; }
                }
                return reject;
            }
            VerticalLayout {
                padding: 20px; spacing: 10px;
                Text { text: root.reset-incomplete ? "继续完成还原" : "一键还原"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                SectionCard {
                    background: Theme.danger-soft;
                    border-color: Theme.danger-line;
                    VerticalLayout {
                        padding: 10px; padding-left: 12px; spacing: 4px;
                        Text { text: root.reset-incomplete ? "还原已确认，但有文件尚未清除。关闭占用文件的程序后继续；重启也会继续完成。" : "永久清除账号、所有软件管理的密码库、自动备份、升级前备份和恢复副本，并将设置恢复默认。"; font-size: 12.5px; color: Theme.danger; wrap: word-wrap; }
                        Text { text: root.reset-summary; font-size: 12.5px; font-weight: 600; color: Theme.ink; wrap: word-wrap; }
                    }
                }
                Text { text: "外部手动导出的备份保留。普通删除不保证清除磁盘上的旧数据痕迹。完成后软件重新启动，回到创建密码库页面。"; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                reset-password := SecretField { visible: !root.reset-incomplete; text <=> root.reset-master; mask-serial: root.secret-serial; label: "还原验证主密码"; placeholder-text: "当前密码库主密码"; enabled: !root.working; }
                if !root.reset-incomplete: CheckBox { text: "我确认永久清除上述数据并恢复默认设置"; checked <=> root.reset-confirmed; enabled: !root.working; }
                if root.status != "": StatusBanner { text: root.status; success: false; compact: true; }
                Rectangle { vertical-stretch: 1; }
                Rectangle { height: 1px; background: Theme.line-subtle; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    reset-cancel := Button { text: "取消还原"; enabled: !root.working && !root.reset-incomplete; clicked => { root.close-reset(); } }
                    reset-continue := Button { text: root.working ? "正在还原…" : root.reset-incomplete ? "继续完成还原" : "验证主密码并还原"; primary: true; danger: true; enabled: !root.working && (root.reset-incomplete || (root.reset-confirmed && root.reset-master != "")); clicked => { root.reset-profile(); } }
                }
            }
        }
    }

    // ==================== 9. CONTEXT MENU ====================
    if root.context-open: Rectangle {
        width: parent.width; height: parent.height;
        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    if (event.button == PointerEventButton.right) { root.request-context(self.mouse-x / 1px, self.mouse-y / 1px); }
                    else { root.context-open = false; root.focus-search(); }
                }
            }
        }
    }
    context-navigation := FocusScope {
        visible: root.context-open;
        x: min(max(0px, root.context-x * 1px), max(0px, root.width - self.width - 8px));
        y: min(max(0px, root.context-y * 1px), max(0px, root.height - self.height - 8px));
        width: 184px; height: root.context-has-record ? 138px : 40px;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.context-open = false; root.focus-search(); return accept; }
            if (event.text == Key.DownArrow || event.text == Key.Tab) { root.context-index = root.context-has-record ? Math.mod(root.context-index + 1,4) : 2; return accept; }
            if (event.text == Key.UpArrow) { root.context-index = root.context-has-record ? Math.mod(root.context-index + 3,4) : 2; return accept; }
            if (event.text == Key.Return) { root.context-action(root.context-index); return accept; }
            return reject;
        }
        Rectangle {
            background: Theme.surface; border-width: 1px; border-color: Theme.line; border-radius: 8px;
            accessible-role: groupbox; accessible-label: "账号右键菜单";
            VerticalLayout {
                padding: 4px; spacing: 2px;
                if root.context-has-record: Button { text: "编辑账号"; menu: true; selected: root.context-index == 0; entered => { root.context-index = 0; } clicked => { root.context-action(0); } }
                if root.context-has-record: Button { text: "删除账号"; menu: true; danger: true; selected: root.context-index == 1; entered => { root.context-index = 1; } clicked => { root.context-action(1); } }
                Button { text: "新增账号"; menu: true; selected: root.context-index == 2; entered => { root.context-index = 2; } clicked => { root.context-action(2); } }
                if root.context-has-record: Button { text: "查看详情"; menu: true; selected: root.context-index == 3; entered => { root.context-index = 3; } clicked => { root.context-action(3); } }
            }
        }
    }

    // ==================== 10. UNSAVED DRAFT CONFIRMATION ====================
    Rectangle {
        visible: root.discard-open;
        width: parent.width; height: parent.height; background: Theme.dark ? #00000099 : #18343155;
        TouchArea {}
        Surface {
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            width: min(460px, parent.width - 48px); height: 204px;
            border-radius: 12px;
            accessible-role: groupbox; accessible-label: "未保存的修改";
            FocusScope {
                capture-key-pressed(event) => {
                    if (event.text == Key.Escape) { root.finish-discard(false); return accept; }
                    if (event.text == Key.Tab) { root.discard-danger-focused = !root.discard-danger-focused; if (root.discard-danger-focused) { discard-button.focus(); } else { keep-editing.focus(); } return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Text { text: "保留当前修改？"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                    Text { text: "离开后，本次尚未保存的账号修改将被丢弃。"; wrap: word-wrap; color: Theme.muted; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        keep-editing := Button { text: "继续编辑"; primary: true; clicked => { root.finish-discard(false); } }
                        discard-button := Button { text: root.discard-action == 4 ? "放弃修改并更新" : root.discard-action == 3 ? "放弃修改并退出" : root.discard-action == 2 ? "放弃修改并收起" : "放弃修改"; danger: true; clicked => { root.finish-discard(true); } }
                    }
                }
            }
        }
    }

    // ==================== 11. READ-ONLY ACCOUNT DETAILS ====================
    Rectangle {
        visible: root.details-open && root.unlocked && !root.verification-active && !root.reset-open;
        width: parent.width; height: parent.height; background: Theme.canvas;
        accessible-role: groupbox; accessible-label: "账号详情";
        FocusScope {
            focus-on-click: false;
            enabled: parent.visible;
            width: parent.width; height: parent.height;
            capture-key-pressed(event) => {
                if (event.modifiers.control && !event.modifiers.shift && event.text == "c") {
                    if (details-password-input.input-focused) { root.copy-details-password(); return accept; }
                    if (details-user-input.has-focus) { root.copy-details-user(); return accept; }
                }
                return reject;
            }
            VerticalLayout {
                padding: 16px; spacing: 10px;
                HorizontalLayout {
                    padding-right: 116px; spacing: 8px;
                    Text { text: "账号详情"; font-size: 20px; font-weight: 700; color: Theme.ink; horizontal-stretch: 0; }
                    Text { text: "只读查看 · 临时复制 15 秒后自动清除"; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 0; }
                    Rectangle { horizontal-stretch: 1; }
                }
                SectionCard {
                    background: Theme.surface-muted;
                    height: 40px;
                    Text { x: 12px; width: parent.width - 24px; height: parent.height; vertical-alignment: center; text: root.details-title; font-size: 16px; font-weight: 600; color: Theme.ink; overflow: elide; }
                }
                ScrollView {
                    vertical-stretch: 1; content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 8px; alignment: start; padding-right: 4px;
                        Text { text: "用户名"; color: Theme.text; font-weight: 600; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 6px;
                            details-user-input := LineEdit { horizontal-stretch: 1; height: Theme.control-height; text: root.details-user; read-only: true; accessible-label: "详情用户名"; }
                            Button { icon: @image-url("../assets/icons/copy.svg"); text: "复制用户名"; label-padding: 10px; enabled: root.details-user != "" && !root.ui-blocked; clicked => { root.copy-details-user(); } }
                        }
                        Text { text: "密码"; color: Theme.text; font-weight: 600; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 6px;
                            details-password-input := SecretField { horizontal-stretch: 1; text <=> root.details-password; mask-serial: root.secret-serial; read-only: true; label: "详情密码"; }
                            Button { icon: @image-url("../assets/icons/copy.svg"); text: "复制密码"; label-padding: 10px; enabled: root.details-password != "" && !root.ui-blocked; clicked => { root.copy-details-password(); } }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout { horizontal-stretch: 1; spacing: 6px; Text { text: "分类"; color: Theme.text; font-weight: 600; font-size: 12px; } LineEdit { height: Theme.control-height; text: root.details-category; read-only: true; accessible-label: "详情分类"; } }
                            VerticalLayout { horizontal-stretch: 1; spacing: 6px; Text { text: "标签"; color: Theme.text; font-weight: 600; font-size: 12px; } LineEdit { height: Theme.control-height; text: root.details-tags; read-only: true; accessible-label: "详情标签"; } }
                        }
                        Text { text: "网址"; color: Theme.text; font-weight: 600; font-size: 12px; }
                        HorizontalLayout {
                            spacing: 6px;
                            LineEdit { horizontal-stretch: 1; height: Theme.control-height; text: root.details-url; read-only: true; accessible-label: "详情网址"; }
                            Button { icon: @image-url("../assets/icons/external.svg"); text: "打开网址"; label-padding: 10px; enabled: root.details-url != "" && !root.ui-blocked; clicked => { root.open-entry-url(); } }
                        }
                        Text { text: "备注"; color: Theme.text; font-weight: 600; font-size: 12px; }
                        TextEdit { text: root.details-notes; read-only: true; height: 92px; accessible-label: "详情备注"; }
                    }
                }
                if root.status != "": StatusBanner { text: root.status; success: root.status-success; }
                Rectangle { height: 1px; background: Theme.line-subtle; }
                HorizontalLayout {
                    spacing: 10px; alignment: start;
                    Button { text: "编辑此账号"; primary: true; enabled: !root.ui-blocked; clicked => { root.edit-entry(); } }
                    details-back := Button { subtle: true; text: "返回账号列表"; enabled: !root.ui-blocked; clicked => { root.close-details(); } }
                }
            }
        }
    }

    // ==================== 12. ABOUT PAGE ====================
    Rectangle {
        visible: root.about-open;
        width: parent.width; height: parent.height; background: Theme.canvas;
        accessible-role: groupbox; accessible-label: "关于 Keyisle";
        VerticalLayout {
            padding: 20px; spacing: 10px;
            HorizontalLayout {
                spacing: 12px; padding-right: 80px;
                BrandMark { width: 42px; height: 42px; border-radius: 12px; }
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text { text: "Keyisle"; font-size: 22px; font-weight: 700; color: Theme.ink; }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text { text: "版本 " + root.app-version; font-size: 12px; color: Theme.muted; }
                        Text { text: "· " + root.install-mode-label + " · 密屿"; font-size: 12px; color: Theme.muted; }
                    }
                }
            }
            SectionCard {
                VerticalLayout {
                    padding: 10px; padding-left: 12px; padding-right: 12px; spacing: 3px;
                    Text { text: "一款轻量、纯粹的 Windows 本地密码管理器。"; font-weight: 600; color: Theme.ink; wrap: word-wrap; }
                    Text { text: "密码库使用 SQLCipher 在本机加密保存，快捷填充采用 Unicode 按键直填，不经过剪贴板。"; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                }
            }
            SectionCard {
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    Text {
                        text: root.update-checking ? "正在检查版本更新…" : root.update-downloading ? "正在下载 Keyisle v" + root.update-version + "…" : root.update-installing ? "校验通过，正在锁库并覆盖安装…" : root.update-status != "" ? root.update-status : root.update-available ? "发现新版本 v" + root.update-version + " · 发布者签名已验证" : "在线更新 · 支持不手动退出直接覆盖升级";
                        font-size: 13px;
                        font-weight: 600;
                        color: root.update-available && !root.update-downloading ? Theme.brand : Theme.ink;
                        wrap: word-wrap;
                    }
                    if root.update-downloading: VerticalLayout {
                        spacing: 4px;
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.surface-muted;
                            clip: true;
                            Rectangle {
                                x: 0px; y: 0px;
                                height: parent.height;
                                width: parent.width * clamp(root.update-progress / 100.0, 0.0, 1.0);
                                border-radius: 3px;
                                background: Theme.brand;
                            }
                        }
                        Text { text: root.update-progress-text; font-size: 11.5px; color: Theme.muted; }
                    }
                    if root.update-available && root.update-notes != "" && !root.update-downloading: Rectangle {
                        background: Theme.surface-muted;
                        border-radius: 7px;
                        VerticalLayout {
                            padding: 8px; padding-left: 10px; padding-right: 10px;
                            Text { text: root.update-notes; font-size: 12px; color: Theme.text; wrap: word-wrap; max-height: 52px; overflow: elide; }
                        }
                    }
                    if root.update-error != "": Text {
                        text: root.update-error;
                        font-size: 12px;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        if root.update-downloading: Button {
                            text: "取消下载";
                            enabled: !root.update-canceling;
                            clicked => { root.cancel-update(); }
                        }
                        if !root.update-downloading && root.update-available: Button {
                            icon: @image-url("../assets/icons/refresh.svg");
                            text: root.update-installing ? "正在启动升级…" : "下载并覆盖安装";
                            primary: true;
                            enabled: !root.update-installing && !root.working;
                            clicked => { root.install-update(); }
                        }
                        if !root.update-downloading && root.update-available: Button {
                            subtle: true;
                            text: "重新检查";
                            enabled: !root.update-checking && !root.update-installing && !root.working;
                            clicked => { root.check-update(); }
                        }
                        if !root.update-downloading && !root.update-available: Button {
                            icon: @image-url("../assets/icons/refresh.svg");
                            text: root.update-checking ? "检查中…" : "检查更新";
                            primary: true;
                            enabled: !root.update-checking && !root.working;
                            clicked => { root.check-update(); }
                        }
                        if !root.update-downloading: Button {
                            icon: @image-url("../assets/icons/external.svg");
                            subtle: true;
                            text: "打开发布页";
                            enabled: !root.update-installing;
                            clicked => { root.open-release-page(); }
                        }
                    }
                }
            }
            SectionCard {
                height: 92px;
                FocusScope {
                    width: parent.width; height: parent.height;
                    accessible-role: button; accessible-label: "Slint 1.18.1，打开项目网站";
                    key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.open-slint-site(); return accept; } return reject; }
                    Rectangle { background: transparent; border-radius: 10px; border-width: parent.has-focus ? 1.5px : 0px; border-color: Theme.brand; }
                    AboutSlint { width: parent.width; height: parent.height; }
                    TouchArea { mouse-cursor: pointer; clicked => { root.open-slint-site(); } }
                }
            }
            Rectangle { vertical-stretch: 1; min-height: 0px; }
            HorizontalLayout {
                alignment: start;
                about-back := Button { text: "返回"; enabled: !root.update-installing; clicked => { root.close-about(); } }
            }
        }
    }

    // ==================== 13. CUSTOM WINDOW CAPTION CONTROLS ====================
    if root.compact: WindowControl {
        kind: 2; x: parent.width - self.width - 8px; y: 12px;
        label: "关闭悬浮框"; clicked => { root.cancel(); }
    }
    if !root.compact: HorizontalLayout {
        x: parent.width - self.width - 8px; y: 16px; width: root.unlocked && !root.fixed-page ? 108px : 72px; height: 30px;
        spacing: 0px;
        WindowControl { kind: 0; label: "最小化窗口"; enabled: !root.discard-open; clicked => { root.minimize-window(); } }
        if root.unlocked && !root.fixed-page: WindowControl { kind: 1; maximized: root.is-maximized; nc-hovered: root.max-hovered; label: "最大化或还原窗口"; enabled: !root.discard-open; clicked => { root.maximize-window(); } }
        WindowControl { kind: 2; label: "关闭窗口"; enabled: !root.working && !root.discard-open; clicked => { root.cancel(); } }
    }
    if root.app-menu-open: Rectangle {
        width: parent.width; height: parent.height;
        TouchArea { pointer-event(event) => { if (event.kind == PointerEventKind.down) { root.app-menu-open = false; root.focus-search(); } } }
    }
    app-menu := FocusScope {
        visible: root.app-menu-open;
        x: root.width - 196px; y: root.height - 196px; width: 180px; height: 108px;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.app-menu-open = false; root.focus-search(); return accept; }
            if (event.text == Key.Tab || event.text == Key.DownArrow || event.text == Key.UpArrow) { root.app-menu-index = Math.mod(root.app-menu-index + (event.text == Key.UpArrow ? 2 : 1),3); return accept; }
            if (event.text == Key.Return) { root.app-menu-open = false; if (root.app-menu-index == 0) { root.cancel(); } else if (root.app-menu-index == 1) { root.exit-app(); } else { root.open-about(); } return accept; }
            return reject;
        }
        Surface {
            border-radius: 8px;
            VerticalLayout {
                padding: 4px; spacing: 2px;
                Button { text: "收起到托盘"; menu: true; selected: root.app-menu-index == 0; entered => { root.app-menu-index = 0; } clicked => { root.app-menu-open = false; root.cancel(); } }
                Button { text: "退出程序"; menu: true; selected: root.app-menu-index == 1; entered => { root.app-menu-index = 1; } clicked => { root.app-menu-open = false; root.exit-app(); } }
                Button { text: "关于 Keyisle"; menu: true; selected: root.app-menu-index == 2; entered => { root.app-menu-index = 2; } clicked => { root.app-menu-open = false; root.open-about(); } }
            }
        }
    }

    Rectangle {
        x: 0.5px; y: 0.5px; width: parent.width - 1px; height: parent.height - 1px;
        background: transparent; border-width: 1px; border-color: Theme.window-line;
        border-radius: root.is-maximized ? 0px : Theme.window-radius;
        accessible-role: none;
    }
}
