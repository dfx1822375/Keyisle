import { ComboBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";

export global Theme {
    in-out property <int> scheme;
    in-out property <bool> dark;
    pure public function canvas-for(is-dark: bool) -> color { return is-dark ? #131820 : #f3f6f8; }
    out property <color> canvas: Theme.canvas-for(dark);
    out property <color> repaint-canvas: dark ? #131821 : #f3f6f9;
    out property <length> window-radius: 12px;
    out property <length> control-height: 36px;
    out property <length> control-radius: 8px;
    out property <color> surface: dark ? #1c2430 : #ffffff;
    out property <color> surface-muted: dark ? #161c26 : #eaeff3;
    out property <color> window-line: dark ? #627080 : #a7b5be;
    out property <string> match-color: dark ? "#ffc17a" : "#a43d00";
    out property <color> ink: dark ? #eaf0f6 : scheme == 1 ? #172d4b : scheme == 2 ? #302342 : scheme == 3 ? #282e36 : #192d2b;
    out property <color> text: dark ? #c6d2de : #3a5057;
    out property <color> muted: dark ? #97a8ba : #53686f;
    out property <color> line: dark ? #384657 : #d8e2e7;
    out property <color> line-subtle: dark ? #2c3846 : #e4ecef;
    out property <color> brand: dark ? (scheme == 1 ? #86b7ff : scheme == 2 ? #c7a5f3 : scheme == 3 ? #b7c5d6 : #78cfc0) : scheme == 1 ? #245db0 : scheme == 2 ? #7043a6 : scheme == 3 ? #455264 : #11675f;
    out property <color> brand-hover: dark ? (scheme == 1 ? #aacdff : scheme == 2 ? #dcc5ff : scheme == 3 ? #d0dbe8 : #9ce2d5) : scheme == 1 ? #194885 : scheme == 2 ? #563180 : scheme == 3 ? #323d4b : #0c554e;
    out property <color> on-brand: dark ? #121e28 : #ffffff;
    out property <color> selection: dark ? (scheme == 1 ? #293d58 : scheme == 2 ? #3c304e : scheme == 3 ? #35414f : #243e3e) : scheme == 1 ? #edf3fd : scheme == 2 ? #f3edfa : scheme == 3 ? #eef0f3 : #e8f3f0;
    out property <color> selection-line: dark ? #7d92a8 : scheme == 1 ? #9bb8df : scheme == 2 ? #c1acd9 : scheme == 3 ? #b3bbc5 : #9bbfb6;
    out property <color> hover: dark ? #2b3746 : scheme == 1 ? #f1f5fc : scheme == 2 ? #f6f1fb : scheme == 3 ? #f2f4f7 : #eef5f4;
    out property <color> danger: dark ? #ffadb4 : #b33e43;
    out property <color> danger-soft: dark ? #4a2c36 : #fbebed;
    out property <color> danger-line: dark ? #6f3d4b : #efb9bf;
    out property <color> on-danger: dark ? #35151c : #ffffff;
    out property <color> close-hover: dark ? #c93838 : #d43528;
    out property <color> success: dark ? #8dd9b2 : #216648;
    out property <color> success-soft: dark ? #1d352b : #eaf6f0;
    out property <color> success-line: dark ? #2f5b47 : #b7dfcb;
    out property <color> warning: dark ? #f4c58f : #7e5423;
    out property <color> warning-soft: dark ? #3f3525 : #fff6e8;
    out property <color> warning-line: dark ? #655235 : #edd5ad;
}

export component Surface inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.window-radius;
    border-width: 1px;
    border-color: Theme.line;
    @children
}

export component SectionCard inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.control-radius;
    border-width: 1px;
    border-color: Theme.line-subtle;
    @children
}

export component FormScrollView inherits ScrollView {
    private property <bool> scrollable: root.content-height > root.visible-height;
    out property <length> scrollbar-gutter;
    // Measure after layout since the gutter itself can change where text wraps.
    function update-gutter() { root.scrollbar-gutter = root.scrollable ? 16px : 0px; }
    init => { root.update-gutter(); }
    changed scrollable => { root.update-gutter(); }
}

export struct StrengthHint { level: int, message: string }

export component StrengthMeter inherits HorizontalLayout {
    in property <StrengthHint> hint;
    private property <color> tone: root.hint.level == 3 ? Theme.success : Theme.warning;
    height: 24px;
    spacing: 8px;
    HorizontalLayout {
        width: 58px; spacing: 4px;
        for segment in 3: Rectangle {
            height: 4px; y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: segment < root.hint.level ? root.tone : Theme.line;
        }
    }
    Text {
        text: root.hint.message; color: root.tone; font-size: 11.5px; font-weight: 600;
        vertical-alignment: center; wrap: word-wrap;
    }
}

export component PageHeading inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 3px;
    Text { text: root.title; color: Theme.ink; font-size: 20px; font-weight: 700; }
    if root.description != "": Text { text: root.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
}

export component ListCaption inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.muted;
    private property <length> inset: root.background.alpha > 0 ? 7px : 0px;
    min-width: caption.preferred-width + 2 * root.inset;
    height: 22px;
    horizontal-stretch: 0;
    border-radius: 5px;
    caption := Text {
        x: root.inset; width: parent.width - 2 * root.inset; height: parent.height;
        text: root.text; color: root.text-color; font-size: 12px; font-weight: 600;
        vertical-alignment: center;
    }
}

export component KeyHint inherits Rectangle {
    in property <string> keys;
    in property <string> action;
    in property <color> action-color: Theme.muted;
    in property <float> fill-alpha: 1;
    min-width: hint.preferred-width;
    height: 22px;
    horizontal-stretch: 0;
    border-radius: 5px;
    background: root.fill-alpha < 1 ? Theme.surface.with-alpha(root.fill-alpha) : transparent;
    hint := HorizontalLayout {
        padding-right: root.fill-alpha < 1 ? 6px : 0px;
        spacing: 5px;
        Rectangle {
            width: shortcut.preferred-width + 12px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.line;
            background: Theme.canvas;
            shortcut := Text {
                text: root.keys; font-family: "Consolas"; font-size: 12px; font-weight: 600; color: Theme.ink;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        if root.action != "": Text {
            text: root.action; font-size: 12px; font-weight: 600; color: root.action-color; vertical-alignment: center;
        }
    }
}

export component SensitiveBadge inherits Rectangle {
    width: 46px;
    height: 19px;
    border-radius: 5px;
    background: Theme.danger-soft;
    border-width: 1px;
    border-color: Theme.danger-line;
    accessible-role: none;
    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 3px;
        alignment: center;
        Image {
            width: 11px;
            height: 11px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../assets/icons/shield.svg");
            colorize: Theme.danger;
        }
        Text {
            text: "敏感";
            font-size: 10.5px;
            font-weight: 600;
            color: Theme.danger;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

export component StatusBanner inherits Rectangle {
    in property <string> text;
    in property <bool> success;
    in property <bool> compact;
    height: max(root.compact ? 30px : 34px, message.preferred-height + (root.compact ? 12px : 16px));
    vertical-stretch: 0;
    border-radius: Theme.control-radius;
    border-width: 1px;
    background: root.success ? Theme.success-soft : Theme.warning-soft;
    border-color: root.success ? Theme.success-line : Theme.warning-line;
    message := Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 24px;
        text: root.text;
        wrap: word-wrap;
        font-size: root.compact ? 12px : 13px;
        color: root.success ? Theme.success : Theme.warning;
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> subtle;
    in property <bool> selected;
    in property <bool> menu;
    in property <bool> enabled: true;
    in property <length> label-padding: 14px;
    in property <length> label-font-size: 13px;
    in property <bool> muted-label;
    in property <float> fill-alpha: 1;
    callback clicked();
    callback entered();
    out property <bool> focused: focus-scope.has-focus;
    out property <bool> hovered: pointer.has-hover;
    private property <bool> key-held;
    private property <bool> has-icon: root.icon.width > 0 && !root.menu;
    private property <color> fg: !root.enabled ? Theme.muted : root.primary ? (root.danger ? Theme.on-danger : Theme.on-brand) : root.danger ? Theme.danger : root.muted-label ? Theme.muted : Theme.ink;
    forward-focus: focus-scope;
    min-width: root.text == "" ? 36px : max(64px, label.preferred-width + (root.has-icon ? 20px : 0px) + root.label-padding * 2);
    height: menu ? 30px : Theme.control-height;
    horizontal-stretch: menu ? 1 : 0;
    vertical-stretch: 0;
    border-radius: menu ? 6px : Theme.control-radius;
    border-width: focus-scope.has-focus && enabled ? 1.5px : 1px;
    border-color: !enabled ? Theme.line-subtle : focus-scope.has-focus ? (danger ? Theme.danger : Theme.brand) : primary ? (danger ? Theme.danger : pointer.has-hover ? Theme.brand-hover : Theme.brand) : selected ? (danger ? Theme.danger-line : Theme.selection-line) : pointer.has-hover ? (danger ? Theme.danger-line : subtle || menu ? transparent : Theme.selection-line) : subtle || menu ? transparent : danger ? Theme.danger-line : Theme.line;
    private property <color> fill: !enabled ? Theme.surface-muted : primary ? (danger ? Theme.danger : pointer.has-hover ? Theme.brand-hover : Theme.brand) : selected || pointer.has-hover ? (danger ? Theme.danger-soft : subtle && !selected ? Theme.hover : Theme.selection) : subtle || menu ? transparent : Theme.surface;
    background: self.fill.transparentize(1 - (root.primary ? max(0.86, root.fill-alpha) : root.fill-alpha));
    opacity: pointer.pressed && enabled ? 0.85 : 1;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        x: root.label-padding;
        width: parent.width - root.label-padding * 2;
        height: parent.height;
        spacing: root.has-icon && root.text != "" ? 6px : 0px;
        alignment: root.menu ? start : center;
        if root.has-icon: Image {
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.fg;
        }
        label := Text {
            text: root.text;
            font-size: root.label-font-size;
            font-weight: root.primary || root.selected ? 600 : 400;
            color: root.fg;
            horizontal-alignment: root.menu ? left : center;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    focus-scope := FocusScope {
        width: parent.width; height: parent.height;
        enabled: root.enabled;
        changed has-focus => { if (!self.has-focus) { root.key-held = false; } }
        key-pressed(event) => {
            if (root.enabled && (event.text == Key.Return || event.text == " ")) { if (!root.key-held) { root.key-held = true; root.clicked(); } return accept; }
            return reject;
        }
        key-released(event) => {
            if (event.text == Key.Return || event.text == " ") { root.key-held = false; return accept; }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
            changed has-hover => { if (self.has-hover && root.enabled) { root.entered(); } }
            clicked => { focus-scope.focus(); root.clicked(); }
        }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <float> fill-alpha: 1;
    in property <string> label;
    callback edited();
    callback accepted();
    callback key-pressed(KeyEvent) -> EventResult;
    private property <bool> translucent: root.fill-alpha < 1;
    public function focus-input() {
        if (root.translucent) { photo-input.focus(); }
        else { native-input.focus(); }
    }

    native-input := LineEdit {
        width: parent.width; height: parent.height;
        visible: !root.translucent;
        enabled: self.visible && root.enabled;
        text <=> root.text; placeholder-text: root.placeholder-text;
        accessible-label: root.label;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
        key-pressed(event) => { root.key-pressed(event) }
    }
    Rectangle {
        visible: root.translucent;
        border-radius: 4px; border-width: 1px; border-color: Theme.line;
        background: Theme.surface.with-alpha(root.fill-alpha);
        TouchArea {
            enabled: root.translucent && root.enabled;
            mouse-cursor: MouseCursor.text;
            clicked => { photo-input.focus(); }
        }
        viewport := Rectangle {
            x: 12px; width: parent.width - 24px - (clear-button.visible ? clear-button.width : 0px);
            height: parent.height; clip: true;
            Text {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                visible: root.text == "" && photo-input.preedit-text == "";
                text: root.placeholder-text; color: Theme.text; vertical-alignment: center; horizontal-alignment: left;
                accessible-role: none;
            }
            ContextMenuArea {
                enabled: root.enabled;
                Menu {
                    MenuItem { title: "撤销"; activated => { photo-input.undo(); } }
                    MenuItem { title: "重做"; activated => { photo-input.redo(); } }
                    MenuSeparator {}
                    MenuItem { title: "剪切"; enabled: root.text != ""; activated => { photo-input.cut(); } }
                    MenuItem { title: "复制"; enabled: root.text != ""; activated => { photo-input.copy(); } }
                    MenuItem { title: "粘贴"; activated => { photo-input.paste(); } }
                    MenuItem { title: "全选"; activated => { photo-input.select-all(); } }
                }
                photo-input := TextInput {
                    property <length> scroll-x;
                    x: clamp(self.scroll-x, min(0px, viewport.width - self.width), 0px);
                    width: max(viewport.width, self.preferred-width + 2px);
                    height: viewport.height;
                    enabled: root.translucent && root.enabled;
                    text <=> root.text;
                    changed text => { if (self.text == "") { self.scroll-x = 0px; } }
                    single-line: true;
                    color: Theme.ink;
                    selection-background-color: Palette.selection-background;
                    selection-foreground-color: Palette.selection-foreground;
                    vertical-alignment: center;
                    accessible-label: root.label;
                    accessible-placeholder-text: root.placeholder-text;
                    accessible-action-set-value(value) => { if (self.enabled) { self.text = value; root.edited(); } }
                    cursor-position-changed(position) => {
                        if (position.x + self.x < 0px) { self.scroll-x = -position.x; }
                        else if (position.x + self.x > viewport.width - 2px) { self.scroll-x = viewport.width - position.x - 2px; }
                    }
                    edited => { root.edited(); }
                    accepted => { root.accepted(); }
                    key-pressed(event) => { root.key-pressed(event) }
                }
            }
        }
        clear-button := Button {
            visible: root.enabled && (photo-input.has-focus || self.focused) && root.text != "";
            x: parent.width - self.width - 5px; y: (parent.height - self.height) / 2;
            width: 24px; height: 24px; label-padding: 4px;
            text: "×"; label-font-size: 18px;
            accessible-label: "清除搜索";
            subtle: true;
            clicked => { root.text = ""; root.edited(); photo-input.focus(); }
        }
        if photo-input.has-focus: Rectangle {
            x: 4px; width: parent.width - 8px; y: parent.height - 2px; height: 2px;
            border-radius: 1px; background: Theme.brand;
        }
    }
}

export component FilterComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index;
    in property <float> fill-alpha: 1;
    in property <string> label;
    callback selected(string);
    private property <bool> translucent: root.fill-alpha < 1;
    forward-focus: native;
    native := ComboBox {
        width: parent.width; height: parent.height;
        model: root.model;
        enabled: root.enabled;
        current-index <=> root.current-index;
        accessible-label: root.label;
        opacity: root.translucent ? 0 : 1;
        selected(value) => { root.selected(value); }
    }
    if root.translucent: Rectangle {
        border-radius: 4px;
        border-width: 1px; border-color: Theme.line;
        background: (hover-area.has-hover ? Theme.hover : Theme.surface).with-alpha(root.fill-alpha);
        accessible-role: none;
        if native.has-focus: Rectangle {
            x: 4px; width: parent.width - 8px; y: parent.height - 2px; height: 2px;
            border-radius: 1px; background: Theme.brand;
        }
        Text {
            x: 11px; width: parent.width - 39px; height: parent.height;
            text: native.current-value; color: root.enabled ? Theme.ink : Theme.muted;
            horizontal-alignment: left; vertical-alignment: center; overflow: elide; accessible-role: none;
        }
        Path {
            x: parent.width - 22px; y: (parent.height - self.height) / 2;
            width: 10px; height: 8px; viewbox-width: 10; viewbox-height: 8;
            commands: "M1 2 L5 6 L9 2";
            stroke: root.enabled ? Theme.ink : Theme.muted; stroke-width: 1.4px;
            accessible-role: none;
        }
        hover-area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { native.focus(); native.accessible-action-expand(); }
        }
    }
}

export component ListEmpty inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> action;
    in property <bool> action-enabled: true;
    in property <color> backing: transparent;
    callback activated();
    if root.backing.alpha > 0: Rectangle {
        width: min(parent.width - 24px, 390px);
        height: empty-content.preferred-height;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-radius: 10px; background: root.backing;
        accessible-role: none;
    }
    empty-content := VerticalLayout {
        padding: 12px; spacing: 8px; alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 40px; height: 40px;
                border-radius: 10px; background: Theme.surface-muted;
                accessible-role: none;
                Image {
                    width: 18px; height: 18px;
                    source: root.icon; colorize: Theme.muted;
                }
            }
        }
        Text {
            text: root.title; color: Theme.ink; font-size: 14px; font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.description; color: Theme.muted; font-size: 12px;
            horizontal-alignment: center; wrap: word-wrap;
        }
        if root.action != "": HorizontalLayout {
            alignment: center;
            Button { text: root.action; subtle: true; enabled: root.action-enabled; clicked => { root.activated(); } }
        }
    }
}

export component SecretField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> revealed;
    in property <int> mask-serial;
    in property <bool> read-only;
    in property <bool> can-reveal: true;
    callback toggle-reveal(bool);
    toggle-reveal(show) => { root.revealed = show; }
    out property <bool> input-focused: input.has-focus;
    callback edited();
    callback accepted();
    forward-focus: input;
    height: Theme.control-height;
    vertical-stretch: 0;
    changed text => { if (!root.read-only && root.text == "") { root.revealed = false; } }
    changed mask-serial => { if (!root.read-only) { root.revealed = false; } }
    HorizontalLayout {
        spacing: 6px;
        input := LineEdit {
            text <=> root.text;
            read-only: root.read-only;
            input-type: root.revealed ? InputType.text : InputType.password;
            placeholder-text: root.placeholder-text;
            accessible-label: root.label == "" ? root.placeholder-text : root.label;
            enabled: root.enabled;
            edited => { root.edited(); }
            accepted => { root.accepted(); }
        }
        Button {
            icon: root.revealed ? @image-url("../assets/icons/eye-off.svg") : @image-url("../assets/icons/eye.svg");
            text: root.revealed ? "隐藏" : "显示";
            label-padding: 10px;
            accessible-label: (root.revealed ? "隐藏" : "显示") + (root.label == "" ? root.placeholder-text : root.label);
            enabled: root.enabled && root.can-reveal;
            subtle: false;
            clicked => { root.toggle-reveal(!root.revealed); }
        }
    }
}

export component WindowControl inherits Rectangle {
    in property <color> resting-background: transparent;
    in property <int> kind;
    in property <bool> maximized;
    in property <bool> nc-hovered;
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked();
    private property <bool> active-hover: root.enabled && (pointer.has-hover || root.nc-hovered);
    private property <color> icon-color: !root.enabled ? Theme.muted : root.kind == 2 && root.active-hover ? #ffffff : Theme.text;
    width: 36px;
    height: 30px;
    border-radius: 6px;
    background: !root.active-hover ? root.resting-background : root.kind == 2 ? Theme.close-hover : Theme.hover;
    opacity: pointer.pressed && root.enabled ? 0.82 : 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Image {
        x: 12px; y: 9px; width: 12px; height: 12px;
        colorize: root.icon-color;
        source: root.kind == 0 ? @image-url("../assets/window/minimize.svg") : root.kind == 2 ? @image-url("../assets/window/close.svg") : root.maximized ? @image-url("../assets/window/restore.svg") : @image-url("../assets/window/maximize.svg");
    }
    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

export component BrandMark inherits Rectangle {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: Theme.brand;
    border-width: 1px;
    border-color: Theme.brand-hover;
    Image {
        source: @image-url("../assets/keyisle-mark.svg");
        colorize: Theme.on-brand;
        width: parent.width;
        height: parent.height;
    }
}
