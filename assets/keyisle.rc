1 ICON "assets/keyisle.ico"
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Keyisle - Local password manager\0"
      VALUE "FileVersion", "@VERSION_DOTS@\0"
      VALUE "ProductName", "Keyisle\0"
      VALUE "ProductVersion", "@VERSION_DOTS@\0"
      VALUE "OriginalFilename", "Keyisle.exe\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
